# Copy this file to .env (same folder) and put your DJI App Key after the = sign.
# The key comes from developer.dji.com, registered for the package name com.plotwise.flight.
# .env is git-ignored: never commit the real key.
DJI_API_KEY=

# Met Office wind forecast (checked before every real flight). Free key from
# datahub.metoffice.gov.uk: sign up, subscribe to "Site Specific" (free plan), copy the API key.
EXPO_PUBLIC_METOFFICE_API_KEY=
