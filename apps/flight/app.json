{
  "expo": {
    "name": "Plotwise Flight",
    "slug": "plotwise-flight",
    "version": "0.1.0",
    "orientation": "default",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.plotwise.app"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true,
            "packagingOptions": {
              "doNotStrip": [
                "*/*/*.so"
              ],
              "pickFirst": [
                "lib/arm64-v8a/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "./plugins/withDji.js",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "dark"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.plotwise.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "extra": {
      "expo-navigation-bar": {
        "style": "dark",
        "hidden": true
      },
      "eas": {
        "projectId": "dcebb96c-b51c-4959-a098-506b8cec4305"
      }
    },
    "owner": "russells1984"
  }
}
